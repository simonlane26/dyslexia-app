{
  "manifest_version": 3,
  "name": "DyslexiaWrite",
  "version": "1.3.0",
  "description": "Confidence support for dyslexic writers — write anywhere with the right tools.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "DyslexiaWrite",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "contextMenus", "scripting", "activeTab"],
  "host_permissions": [
    "https://www.dyslexiawrite.com/*",
    "https://mail.google.com/*",
    "https://*.outlook.live.com/*",
    "https://*.outlook.office.com/*",
    "https://*.slack.com/*",
    "https://teams.microsoft.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": ["https://www.dyslexiawrite.com/*", "https://dyslexiawrite.com/*"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://*.outlook.live.com/*",
        "https://*.outlook.office.com/*",
        "https://*.slack.com/*",
        "https://teams.microsoft.com/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
