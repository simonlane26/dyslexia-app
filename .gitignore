# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# generated AppSumo redemption codes — sensitive, single-use, never commit
/appsumo-codes-*.csv

# raw/original video exports — far too large to commit; the compressed
# web-ready derivatives live in /public instead
/video-source/
.tmp-video-work/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
